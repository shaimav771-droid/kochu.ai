# Google Sheets Prompt Database Configuration (Server-Side Only)
# =====================================================================
# IMPORTANT: Keep all Google Cloud credentials and spreadsheet configuration
# server-side. Do NOT prefix these keys with VITE_ to prevent Vite from
# leaking them into client browser bundles.
# =====================================================================

# 1. Google Cloud Service Account Email
# Created in Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=kochu-sheets-service@your-project-id.iam.gserviceaccount.com

# 2. Google Cloud Service Account Private Key
# Downloaded as JSON from Google Cloud Console.
# In .env files, newlines can be literal or encoded with \n (the server handles both).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Google Sheets Spreadsheet ID
# The spreadsheet ID is found in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here

# 4. Sheet Tab Name (Optional, defaults to "Sheet1")
# The exact name of the tab in your spreadsheet.
# Ensure the sheet has these exact columns in row 1:
# resource_id | title | prompt | published
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# 5. Server-Side Cache TTL in Seconds (Optional, defaults to 30)
# A short cache duration allows real-time edits, publishing, and unpublishing
# in Google Sheets to reflect quickly without hitting Google API quotas.
CACHE_TTL_SECONDS=30
